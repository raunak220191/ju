<?xml version="1.0" encoding="UTF-8"?>
<definitions
        xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
        xmlns:tns="http://example.com/hello"
        xmlns:xsd="http://www.w3.org/2001/XMLSchema"
        xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
        targetNamespace="http://example.com/hello"
        name="HelloWorldService">

    <!-- Import the XSD defining sayHelloRequest/Response -->
    <types>
        <xsd:schema>
            <xsd:import namespace="http://example.com/hello" schemaLocation="hello.xsd"/>
        </xsd:schema>
    </types>

    <!-- Messages -->
    <message name="sayHelloRequest">
        <part name="parameters" element="tns:sayHelloRequest"/>
    </message>

    <message name="sayHelloResponse">
        <part name="parameters" element="tns:sayHelloResponse"/>
    </message>

    <!-- PortType -->
    <portType name="HelloWorldPortType">
        <operation name="sayHello">
            <input message="tns:sayHelloRequest"/>
            <output message="tns:sayHelloResponse"/>
        </operation>
    </portType>

    <!-- Binding -->
    <binding name="HelloWorldBinding" type="tns:HelloWorldPortType">
        <soap:binding transport="http://schemas.xmlsoap.org/soap/http" style="document"/>
        <operation name="sayHello">
            <soap:operation soapAction="sayHelloAction"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
    </binding>

    <!-- Service -->
    <service name="HelloWorldService">
        <port name="HelloWorldPort" binding="tns:HelloWorldBinding">
            <soap:address location="http://localhost:8080/ws"/>
        </port>
    </service>
</definitions>
